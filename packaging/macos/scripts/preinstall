#!/bin/bash

set -euo pipefail

legacy_app="${EASY2SAY_APPLICATIONS_DIR:-/Applications}/v2s.app"
legacy_info="$legacy_app/Contents/Info.plist"
expected_bundle_id="com.franklioxygen.v2s"

if [[ ! -d "$legacy_app" || ! -f "$legacy_info" ]]; then
  exit 0
fi

bundle_id="$(/usr/bin/plutil -extract CFBundleIdentifier raw "$legacy_info" 2>/dev/null || true)"
if [[ "$bundle_id" != "$expected_bundle_id" ]]; then
  echo "Leaving unrelated legacy path in place: $legacy_app" >&2
  exit 0
fi

/bin/rm -rf "$legacy_app"
echo "Removed legacy v2s.app before installing Easy2say.app."
