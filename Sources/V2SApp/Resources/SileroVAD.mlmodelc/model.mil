program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-torch", "2.7.0"}, {"coremltools-source-dialect", "TorchScript"}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp32, [1, 576]> audio, tensor<fp32, [2, 1, 128]> recurrent_state) {
            tensor<fp32, [258, 1, 256]> self_stft_basis = const()[name = string("self_stft_basis"), val = tensor<fp32, [258, 1, 256]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64)))];
            tensor<fp32, [128, 129, 3]> self_encoder0_weight = const()[name = string("self_encoder0_weight"), val = tensor<fp32, [128, 129, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(264320)))];
            tensor<fp32, [128]> self_encoder0_bias = const()[name = string("self_encoder0_bias"), val = tensor<fp32, [128]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(462528)))];
            tensor<fp32, [64, 128, 3]> self_encoder1_weight = const()[name = string("self_encoder1_weight"), val = tensor<fp32, [64, 128, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(463104)))];
            tensor<fp32, [64]> self_encoder1_bias = const()[name = string("self_encoder1_bias"), val = tensor<fp32, [64]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(561472)))];
            tensor<fp32, [64, 64, 3]> self_encoder2_weight = const()[name = string("self_encoder2_weight"), val = tensor<fp32, [64, 64, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(561792)))];
            tensor<fp32, [64]> self_encoder2_bias = const()[name = string("self_encoder2_bias"), val = tensor<fp32, [64]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(611008)))];
            tensor<fp32, [128, 64, 3]> self_encoder3_weight = const()[name = string("self_encoder3_weight"), val = tensor<fp32, [128, 64, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(611328)))];
            tensor<fp32, [128]> self_encoder3_bias = const()[name = string("self_encoder3_bias"), val = tensor<fp32, [128]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(709696)))];
            tensor<fp32, [512, 128]> self_lstm_weight_ih = const()[name = string("self_lstm_weight_ih"), val = tensor<fp32, [512, 128]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(710272)))];
            tensor<fp32, [512]> self_lstm_bias_ih = const()[name = string("self_lstm_bias_ih"), val = tensor<fp32, [512]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(972480)))];
            tensor<fp32, [512, 128]> self_lstm_weight_hh = const()[name = string("self_lstm_weight_hh"), val = tensor<fp32, [512, 128]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(974592)))];
            tensor<fp32, [512]> self_lstm_bias_hh = const()[name = string("self_lstm_bias_hh"), val = tensor<fp32, [512]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(1236800)))];
            tensor<fp32, [1, 128, 1]> self_decoder_weight = const()[name = string("self_decoder_weight"), val = tensor<fp32, [1, 128, 1]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(1238912)))];
            tensor<fp32, [1]> self_decoder_bias = const()[name = string("self_decoder_bias"), val = tensor<fp32, [1]>([-0x1.3fcb46p-1])];
            fp32 const_0 = const()[name = string("const_0"), val = fp32(0x0p+0)];
            tensor<int32, [4]> padded_pad_0 = const()[name = string("padded_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 64])];
            string padded_mode_0 = const()[name = string("padded_mode_0"), val = string("reflect")];
            tensor<fp32, [1, 640]> padded = pad(constant_val = const_0, mode = padded_mode_0, pad = padded_pad_0, x = audio)[name = string("padded")];
            tensor<int32, [1]> var_38_axes_0 = const()[name = string("op_38_axes_0"), val = tensor<int32, [1]>([1])];
            tensor<fp32, [1, 1, 640]> var_38 = expand_dims(axes = var_38_axes_0, x = padded)[name = string("op_38")];
            string spectrum_pad_type_0 = const()[name = string("spectrum_pad_type_0"), val = string("valid")];
            tensor<int32, [1]> spectrum_strides_0 = const()[name = string("spectrum_strides_0"), val = tensor<int32, [1]>([128])];
            tensor<int32, [2]> spectrum_pad_0 = const()[name = string("spectrum_pad_0"), val = tensor<int32, [2]>([0, 0])];
            tensor<int32, [1]> spectrum_dilations_0 = const()[name = string("spectrum_dilations_0"), val = tensor<int32, [1]>([1])];
            int32 spectrum_groups_0 = const()[name = string("spectrum_groups_0"), val = int32(1)];
            tensor<fp32, [1, 258, 4]> spectrum = conv(dilations = spectrum_dilations_0, groups = spectrum_groups_0, pad = spectrum_pad_0, pad_type = spectrum_pad_type_0, strides = spectrum_strides_0, weight = self_stft_basis, x = var_38)[name = string("spectrum")];
            tensor<int32, [3]> var_41_begin_0 = const()[name = string("op_41_begin_0"), val = tensor<int32, [3]>([0, 0, 0])];
            tensor<int32, [3]> var_41_end_0 = const()[name = string("op_41_end_0"), val = tensor<int32, [3]>([1, 129, 4])];
            tensor<bool, [3]> var_41_end_mask_0 = const()[name = string("op_41_end_mask_0"), val = tensor<bool, [3]>([true, false, true])];
            tensor<fp32, [1, 129, 4]> var_41 = slice_by_index(begin = var_41_begin_0, end = var_41_end_0, end_mask = var_41_end_mask_0, x = spectrum)[name = string("op_41")];
            tensor<int32, [3]> var_43_begin_0 = const()[name = string("op_43_begin_0"), val = tensor<int32, [3]>([0, 129, 0])];
            tensor<int32, [3]> var_43_end_0 = const()[name = string("op_43_end_0"), val = tensor<int32, [3]>([1, 258, 4])];
            tensor<bool, [3]> var_43_end_mask_0 = const()[name = string("op_43_end_mask_0"), val = tensor<bool, [3]>([true, true, true])];
            tensor<fp32, [1, 129, 4]> var_43 = slice_by_index(begin = var_43_begin_0, end = var_43_end_0, end_mask = var_43_end_mask_0, x = spectrum)[name = string("op_43")];
            tensor<fp32, [1, 129, 4]> var_45 = mul(x = var_41, y = var_41)[name = string("op_45")];
            tensor<fp32, [1, 129, 4]> var_46 = mul(x = var_43, y = var_43)[name = string("op_46")];
            tensor<fp32, [1, 129, 4]> var_47 = add(x = var_45, y = var_46)[name = string("op_47")];
            tensor<fp32, [1, 129, 4]> encoded_1 = sqrt(x = var_47)[name = string("encoded_1")];
            string input_1_pad_type_0 = const()[name = string("input_1_pad_type_0"), val = string("custom")];
            tensor<int32, [2]> input_1_pad_0 = const()[name = string("input_1_pad_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [1]> input_1_strides_0 = const()[name = string("input_1_strides_0"), val = tensor<int32, [1]>([1])];
            tensor<int32, [1]> input_1_dilations_0 = const()[name = string("input_1_dilations_0"), val = tensor<int32, [1]>([1])];
            int32 input_1_groups_0 = const()[name = string("input_1_groups_0"), val = int32(1)];
            tensor<fp32, [1, 128, 4]> input_1 = conv(bias = self_encoder0_bias, dilations = input_1_dilations_0, groups = input_1_groups_0, pad = input_1_pad_0, pad_type = input_1_pad_type_0, strides = input_1_strides_0, weight = self_encoder0_weight, x = encoded_1)[name = string("input_1")];
            tensor<fp32, [1, 128, 4]> encoded_3 = relu(x = input_1)[name = string("encoded_3")];
            string input_3_pad_type_0 = const()[name = string("input_3_pad_type_0"), val = string("custom")];
            tensor<int32, [2]> input_3_pad_0 = const()[name = string("input_3_pad_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [1]> input_3_strides_0 = const()[name = string("input_3_strides_0"), val = tensor<int32, [1]>([2])];
            tensor<int32, [1]> input_3_dilations_0 = const()[name = string("input_3_dilations_0"), val = tensor<int32, [1]>([1])];
            int32 input_3_groups_0 = const()[name = string("input_3_groups_0"), val = int32(1)];
            tensor<fp32, [1, 64, 2]> input_3 = conv(bias = self_encoder1_bias, dilations = input_3_dilations_0, groups = input_3_groups_0, pad = input_3_pad_0, pad_type = input_3_pad_type_0, strides = input_3_strides_0, weight = self_encoder1_weight, x = encoded_3)[name = string("input_3")];
            tensor<fp32, [1, 64, 2]> encoded_5 = relu(x = input_3)[name = string("encoded_5")];
            string input_5_pad_type_0 = const()[name = string("input_5_pad_type_0"), val = string("custom")];
            tensor<int32, [2]> input_5_pad_0 = const()[name = string("input_5_pad_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [1]> input_5_strides_0 = const()[name = string("input_5_strides_0"), val = tensor<int32, [1]>([2])];
            tensor<int32, [1]> input_5_dilations_0 = const()[name = string("input_5_dilations_0"), val = tensor<int32, [1]>([1])];
            int32 input_5_groups_0 = const()[name = string("input_5_groups_0"), val = int32(1)];
            tensor<fp32, [1, 64, 1]> input_5 = conv(bias = self_encoder2_bias, dilations = input_5_dilations_0, groups = input_5_groups_0, pad = input_5_pad_0, pad_type = input_5_pad_type_0, strides = input_5_strides_0, weight = self_encoder2_weight, x = encoded_5)[name = string("input_5")];
            tensor<fp32, [1, 64, 1]> encoded_7 = relu(x = input_5)[name = string("encoded_7")];
            string input_7_pad_type_0 = const()[name = string("input_7_pad_type_0"), val = string("custom")];
            tensor<int32, [2]> input_7_pad_0 = const()[name = string("input_7_pad_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [1]> input_7_strides_0 = const()[name = string("input_7_strides_0"), val = tensor<int32, [1]>([1])];
            tensor<int32, [1]> input_7_dilations_0 = const()[name = string("input_7_dilations_0"), val = tensor<int32, [1]>([1])];
            int32 input_7_groups_0 = const()[name = string("input_7_groups_0"), val = int32(1)];
            tensor<fp32, [1, 128, 1]> input_7 = conv(bias = self_encoder3_bias, dilations = input_7_dilations_0, groups = input_7_groups_0, pad = input_7_pad_0, pad_type = input_7_pad_type_0, strides = input_7_strides_0, weight = self_encoder3_weight, x = encoded_7)[name = string("input_7")];
            tensor<fp32, [1, 128, 1]> var_56 = relu(x = input_7)[name = string("op_56")];
            tensor<int32, [1]> encoded_axes_0 = const()[name = string("encoded_axes_0"), val = tensor<int32, [1]>([-1])];
            tensor<fp32, [1, 128]> encoded = squeeze(axes = encoded_axes_0, x = var_56)[name = string("encoded")];
            tensor<int32, [3]> previous_hidden_begin_0 = const()[name = string("previous_hidden_begin_0"), val = tensor<int32, [3]>([0, 0, 0])];
            tensor<int32, [3]> previous_hidden_end_0 = const()[name = string("previous_hidden_end_0"), val = tensor<int32, [3]>([1, 1, 128])];
            tensor<bool, [3]> previous_hidden_end_mask_0 = const()[name = string("previous_hidden_end_mask_0"), val = tensor<bool, [3]>([false, true, true])];
            tensor<bool, [3]> previous_hidden_squeeze_mask_0 = const()[name = string("previous_hidden_squeeze_mask_0"), val = tensor<bool, [3]>([true, false, false])];
            tensor<fp32, [1, 128]> previous_hidden = slice_by_index(begin = previous_hidden_begin_0, end = previous_hidden_end_0, end_mask = previous_hidden_end_mask_0, squeeze_mask = previous_hidden_squeeze_mask_0, x = recurrent_state)[name = string("previous_hidden")];
            tensor<int32, [3]> previous_cell_begin_0 = const()[name = string("previous_cell_begin_0"), val = tensor<int32, [3]>([1, 0, 0])];
            tensor<int32, [3]> previous_cell_end_0 = const()[name = string("previous_cell_end_0"), val = tensor<int32, [3]>([2, 1, 128])];
            tensor<bool, [3]> previous_cell_end_mask_0 = const()[name = string("previous_cell_end_mask_0"), val = tensor<bool, [3]>([false, true, true])];
            tensor<bool, [3]> previous_cell_squeeze_mask_0 = const()[name = string("previous_cell_squeeze_mask_0"), val = tensor<bool, [3]>([true, false, false])];
            tensor<fp32, [1, 128]> previous_cell = slice_by_index(begin = previous_cell_begin_0, end = previous_cell_end_0, end_mask = previous_cell_end_mask_0, squeeze_mask = previous_cell_squeeze_mask_0, x = recurrent_state)[name = string("previous_cell")];
            tensor<fp32, [1, 512]> gates_1 = linear(bias = self_lstm_bias_ih, weight = self_lstm_weight_ih, x = encoded)[name = string("linear_0")];
            tensor<fp32, [1, 512]> var_61 = linear(bias = self_lstm_bias_hh, weight = self_lstm_weight_hh, x = previous_hidden)[name = string("linear_1")];
            tensor<fp32, [1, 512]> gates = add(x = gates_1, y = var_61)[name = string("gates")];
            tensor<int32, [2]> var_64_begin_0 = const()[name = string("op_64_begin_0"), val = tensor<int32, [2]>([0, 0])];
            tensor<int32, [2]> var_64_end_0 = const()[name = string("op_64_end_0"), val = tensor<int32, [2]>([1, 128])];
            tensor<bool, [2]> var_64_end_mask_0 = const()[name = string("op_64_end_mask_0"), val = tensor<bool, [2]>([true, false])];
            tensor<fp32, [1, 128]> var_64 = slice_by_index(begin = var_64_begin_0, end = var_64_end_0, end_mask = var_64_end_mask_0, x = gates)[name = string("op_64")];
            tensor<fp32, [1, 128]> input_gate = sigmoid(x = var_64)[name = string("input_gate")];
            tensor<int32, [2]> var_66_begin_0 = const()[name = string("op_66_begin_0"), val = tensor<int32, [2]>([0, 128])];
            tensor<int32, [2]> var_66_end_0 = const()[name = string("op_66_end_0"), val = tensor<int32, [2]>([1, 256])];
            tensor<bool, [2]> var_66_end_mask_0 = const()[name = string("op_66_end_mask_0"), val = tensor<bool, [2]>([true, false])];
            tensor<fp32, [1, 128]> var_66 = slice_by_index(begin = var_66_begin_0, end = var_66_end_0, end_mask = var_66_end_mask_0, x = gates)[name = string("op_66")];
            tensor<fp32, [1, 128]> forget_gate = sigmoid(x = var_66)[name = string("forget_gate")];
            tensor<int32, [2]> var_68_begin_0 = const()[name = string("op_68_begin_0"), val = tensor<int32, [2]>([0, 256])];
            tensor<int32, [2]> var_68_end_0 = const()[name = string("op_68_end_0"), val = tensor<int32, [2]>([1, 384])];
            tensor<bool, [2]> var_68_end_mask_0 = const()[name = string("op_68_end_mask_0"), val = tensor<bool, [2]>([true, false])];
            tensor<fp32, [1, 128]> var_68 = slice_by_index(begin = var_68_begin_0, end = var_68_end_0, end_mask = var_68_end_mask_0, x = gates)[name = string("op_68")];
            tensor<fp32, [1, 128]> cell_gate = tanh(x = var_68)[name = string("cell_gate")];
            tensor<int32, [2]> var_70_begin_0 = const()[name = string("op_70_begin_0"), val = tensor<int32, [2]>([0, 384])];
            tensor<int32, [2]> var_70_end_0 = const()[name = string("op_70_end_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<bool, [2]> var_70_end_mask_0 = const()[name = string("op_70_end_mask_0"), val = tensor<bool, [2]>([true, true])];
            tensor<fp32, [1, 128]> var_70 = slice_by_index(begin = var_70_begin_0, end = var_70_end_0, end_mask = var_70_end_mask_0, x = gates)[name = string("op_70")];
            tensor<fp32, [1, 128]> output_gate = sigmoid(x = var_70)[name = string("output_gate")];
            tensor<fp32, [1, 128]> var_72 = mul(x = forget_gate, y = previous_cell)[name = string("op_72")];
            tensor<fp32, [1, 128]> var_73 = mul(x = input_gate, y = cell_gate)[name = string("op_73")];
            tensor<fp32, [1, 128]> cell = add(x = var_72, y = var_73)[name = string("cell")];
            tensor<fp32, [1, 128]> var_75 = tanh(x = cell)[name = string("op_75")];
            tensor<fp32, [1, 128]> input = mul(x = output_gate, y = var_75)[name = string("input")];
            tensor<fp32, [1, 128]> var_77 = relu(x = input)[name = string("op_77")];
            tensor<int32, [1]> var_78_axes_0 = const()[name = string("op_78_axes_0"), val = tensor<int32, [1]>([-1])];
            tensor<fp32, [1, 128, 1]> var_78 = expand_dims(axes = var_78_axes_0, x = var_77)[name = string("op_78")];
            string logits_pad_type_0 = const()[name = string("logits_pad_type_0"), val = string("valid")];
            tensor<int32, [1]> logits_strides_0 = const()[name = string("logits_strides_0"), val = tensor<int32, [1]>([1])];
            tensor<int32, [2]> logits_pad_0 = const()[name = string("logits_pad_0"), val = tensor<int32, [2]>([0, 0])];
            tensor<int32, [1]> logits_dilations_0 = const()[name = string("logits_dilations_0"), val = tensor<int32, [1]>([1])];
            int32 logits_groups_0 = const()[name = string("logits_groups_0"), val = int32(1)];
            tensor<fp32, [1, 1, 1]> logits = conv(bias = self_decoder_bias, dilations = logits_dilations_0, groups = logits_groups_0, pad = logits_pad_0, pad_type = logits_pad_type_0, strides = logits_strides_0, weight = self_decoder_weight, x = var_78)[name = string("logits")];
            tensor<fp32, [1, 1, 1]> var_80 = sigmoid(x = logits)[name = string("op_80")];
            tensor<int32, [1]> var_81_axes_0 = const()[name = string("op_81_axes_0"), val = tensor<int32, [1]>([-1])];
            tensor<fp32, [1, 1]> probability = squeeze(axes = var_81_axes_0, x = var_80)[name = string("op_81")];
            int32 var_83_axis_0 = const()[name = string("op_83_axis_0"), val = int32(0)];
            tensor<fp32, [2, 1, 128]> state_out = stack(axis = var_83_axis_0, values = (input, cell))[name = string("op_83")];
        } -> (probability, state_out);
}